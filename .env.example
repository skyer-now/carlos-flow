# Carlos 工作流 - Cindy 版环境变量模板
# 复制为 .env 并修改，或在 Cindy 插件设置页填写

# === 必填：MCP 源码根目录（包含 src/、bridge/、client/）===
CARLOS_FLOW_MCP_ROOT=D:/cindy/carlos-flow-mcp

# === 必填：状态/审计/快照根目录 ===
# Windows: D:/opencode-backups
# macOS/Linux: ~/carlos-flow
CARLOS_FLOW_HOME=~/carlos-flow

# === 可选：Bridge 监听端口（默认 19099）===
BRIDGE_PORT=19099

# === 可选：Bridge 认证 Token（自动生成，无需手动设置）===
# CARLOS_BRIDGE_TOKEN=carlos-local-token-2026

# === 可选：rea 相关（如需使用 rea 工具）===
# REA_MCP_ROOT=D:/dev-env/rea
# GHIDRA_HOME=D:/dev-env/ghidra/ghidra_12.1.4_PUBLIC
# JAVA_HOME=D:/dev-env/jdk-21.0.12.1+1
# NODE_PATH=node