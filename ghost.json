      "description": "\u6267\u884c\u5361\u7247\u4e2d\u6307\u5b9a\u7684\u9a8c\u8bc1\u547d\u4ee4\uff0c\u8fd4\u56de\u6267\u884c\u7ed3\u679c\uff08\u9000\u51fa\u7801\u3001stdout\u3001stderr\uff09\u3002\u7528\u4e8e\u5728\u6d3e\u53d1 executor \u540e\u9a8c\u8bc1\u5176\u5de5\u4f5c\u6210\u679c\uff0c\u6216\u624b\u52a8\u89e6\u53d1\u9a8c\u8bc1\u3002\u8bb0 PASS \u88c1\u5b9a\u524d\u5fc5\u987b\u5148\u8dd1\u901a\u672c\u5de5\u5177\u3002",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "\u4f1a\u8bdd ID\uff0c\u9ed8\u8ba4 unknown"
          },
          "cwd": {
            "type": "string",
            "description": "\u5de5\u4f5c\u76ee\u5f55\uff0c\u9ed8\u8ba4 process.cwd()"
          }
        }
      }
    },
    {
      "name": "flow_falsify",
      "description": "\u8d1f\u5bf9\u7167\uff08negative control\uff09\uff1a\u628a\u5de5\u4f5c\u533a\u8fd8\u539f\u5230\u6d3e\u53d1\u65f6\u7684\u300c\u6539\u52a8\u524d\u300d\u72b6\u6001\u8dd1\u540c\u4e00 verify.cmd\uff0c\u8981\u6c42\u5b83\u5931\u8d25\uff1b\u518d\u8fd8\u539f\u300c\u6539\u52a8\u540e\u300d\u72b6\u6001\u8dd1\u4e00\u6b21\uff0c\u8981\u6c42\u5b83\u901a\u8fc7\u3002\u53ea\u6709\u300c\u6539\u52a8\u524d\u5931\u8d25 + \u6539\u52a8\u540e\u901a\u8fc7\u300d\u624d\u8bc1\u660e\u8fd9\u4e2a\u6d4b\u8bd5\u771f\u7684\u5728\u6d4b\u672c\u6b21\u6539\u52a8\uff08\u800c\u4e0d\u662f `|| true` / `echo ok` \u8fd9\u7c7b\u7a7a\u6d4b\u8bd5\uff09\u3002\u8bb0 PASS \u88c1\u5b9a\u524d\u5fc5\u987b\u5148\u505a\u8d1f\u5bf9\u7167\u3002",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "\u4f1a\u8bdd ID\uff0c\u9ed8\u8ba4 unknown"
          },
          "cwd": {
            "type": "string",
            "description": "\u5de5\u4f5c\u76ee\u5f55\uff0c\u9ed8\u8ba4 process.cwd()"
          }
        }
      }
    },
    {
      "name": "flow_check_scope",
      "description": "\u68c0\u67e5\u6307\u5b9a\u6587\u4ef6\u5217\u8868\u662f\u5426\u5728\u5361\u7247 scope \u8303\u56f4\u5185\u3002\u7528\u4e8e\u5728\u63d0\u4ea4\u88c1\u5b9a\u524d\u81ea\u67e5\u8d8a\u754c\u6539\u52a8\u3002\u7a7a scope \u5224\u5b9a\u4e3a\u5168\u90e8\u8d8a\u754c\uff08fail-closed\uff09\u3002",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "\u4f1a\u8bdd ID\uff0c\u9ed8\u8ba4 unknown"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "\u8981\u68c0\u67e5\u7684\u6587\u4ef6\u8def\u5f84\u5217\u8868"
          },
          "cwd": {
            "type": "string",
            "description": "\u4ed3\u5e93\u5de5\u4f5c\u76ee\u5f55\uff0c\u9ed8\u8ba4 process.cwd()"
          }
        },
        "required": [
          "sessionId"
        ]
      }
    },
    {
      "name": "flow_trigger_check",
      "description": "\u667a\u80fd\u89e6\u53d1\u68c0\u67e5\uff1a\u5224\u65ad\u5f53\u524d\u8fd9\u6761\u7528\u6237\u6d88\u606f\u662f\u5426\u5e94\u8be5\u542f\u52a8 Carlos \u5de5\u4f5c\u6d41\uff0c\u5e76\u5728\u8fbe\u6807\u65f6\u5b9e\u9645\u5b8c\u6210\u6fc0\u6d3b\uff08\u5199\u5165\u7528\u6237\u539f\u8bdd + \u5f00\u5360\u4f4d\u5361 \u2192 \u4f1a\u8bdd\u8fdb\u5165\u95e8\u7981\u6001\uff09\u3002\u5bbf\u4e3b\u5728\u6536\u5230\u7528\u6237\u6d88\u606f\u65f6\u8c03\u7528\u672c\u5de5\u5177\uff0c\u5c31\u80fd\u83b7\u5f97\u4e0e\u547d\u4ee4\u884c\u5ba2\u6237\u7aef\u5b8c\u5168\u4e00\u81f4\u7684\u81ea\u52a8\u89e6\u53d1\u884c\u4e3a\u3002\u672a\u8fbe\u9608\u503c\u65f6\u53ea\u5982\u5b9e\u8fd4\u56de\u8bc4\u5206\u4e0e\u51b3\u7b56\uff0c\u4e0d\u505a\u4efb\u4f55\u52a8\u4f5c\uff1b\u88ab\u9650\u6d41\u65f6\u4e5f\u5982\u5b9e\u8fd4\u56de\u771f\u5b9e\u8bc4\u5206\u3002\u4e2d\u6587\u6d41\u7a0b\u8bcd\uff08\u5de5\u4f5c\u6d41/\u95e8\u7981/\u6d3e\u53d1/\u5ba1\u8ba1\u2026\uff09\u5df2\u5185\u7f6e\uff0c\u4e2d\u6587\u9700\u6c42\u540c\u6837\u80fd\u89e6\u53d1\u3002",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "\u4f1a\u8bdd ID\uff0c\u9ed8\u8ba4 unknown"
          },
          "message": {
            "type": "string",
            "description": "\u7528\u6237\u672c\u8f6e\u6d88\u606f\u539f\u6587\uff08\u5fc5\u987b\u662f\u771f\u5b9e\u539f\u8bdd\uff0c\u7528\u4e8e quote \u951a\u70b9\uff09"
          },
          "complexity": {
            "type": "number",
            "description": "\u4efb\u52a1\u590d\u6742\u5ea6\u7cfb\u6570\uff0c\u9ed8\u8ba4 1.0"
          },
          "execute": {
            "type": "boolean",
            "description": "true = \u8fbe\u6807\u65f6\u5b9e\u9645\u6267\u884c\u6fc0\u6d3b\u6b65\u9aa4\uff08\u9ed8\u8ba4 true\uff09\uff1bfalse = \u53ea\u8bc4\u5206\u4e0d\u52a8\u4f5c"
          },
          "cwd": {
            "type": "string",
            "description": "\u5de5\u4f5c\u76ee\u5f55\uff0c\u9ed8\u8ba4 process.cwd()"
          }
        },
        "required": [
          "message"
        ]
      }
    },
    {
