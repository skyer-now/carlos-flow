{
  "schemaVersion": 3,
  "minCindyVersion": "1.0.2",
  "id": "carlos-flow",
  "name": "Carlos 工作流",
  "description": "机械门禁 MCP：留痕/派发/裁定/审计/快照/免检/还原。自动管理 Bridge 后台常驻，首次调用 ~3-5s，后续 ~1s。",
  "whenToUse": "需要走 Carlos 工作流门禁时使用：留痕/派发/裁定/审计/快照/免检/还原",
  "version": "2.12.0",
  "kind": "mcp",
  "entry": "client/carlos.js",
  "command": "门禁",
  "node": {
    "entry": "__ROOT__/bridge/mcp-bridge.js",
    "protocol": "json-rpc-stdio",
    "lifecycle": "on-demand",
    "idleTimeoutSeconds": 300
  },
  "settingsHtml": "settings.html",
  "tools": [
    {
      "name": "flow_mode",
      "description": "切换工作流模式：pro（专业）/ guide（向导）。",
      "parameters": { "type": "object", "properties": { "sessionId": { "type": "string" }, "mode": { "type": "string", "enum": ["pro", "guide"] }, "reason": { "type": "string" } }, "required": ["mode"] }
    },
    {
      "name": "flow_protocol",
      "description": "读取 Carlos 工作流协议全文（路由档位 T0/T1/T2、四段合同、报告规格、错误分层、状态字段、审计事件类型、免检触发词、任务卡模板）。",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "flow_submit_requirement",
      "description": "提交（留痕）一张任务卡，作为后续派发的唯一依据。任何 T2 改动前必须先调用本工具。",
      "parameters": {
        "type": "object",
        "properties": {
          "goal": {
            "type": "string",
            "description": "一句话目标（任务卡 objective）"
          },
          "quote": {
            "type": "string",
            "description": "用户原话摘录，用于锚点校验，必须能在用户消息中定位"
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "只准改动的文件清单（相对 cwd 的路径）"
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "可判定的验收标准"
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "未知/待澄清事项"
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "已做的假设"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "number"
                }
              },
              "required": [
                "path",
                "line"
              ]
            },
            "description": "关键定位点"
          },
          "verify": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string"
              }
            },
            "description": "主 Agent 指定的验证命令"
          },
          "confirmed": {
            "type": "boolean",
            "description": "敏感路径是否已获用户确认（sensitive 档必须为 true）"
          },
          "parallel_plan": {
            "type": "string",
            "description": "并行派发计划说明（可选）"
          },
          "sessionId": {
            "type": "string",
            "description": "会话 ID，默认 unknown"
          },
          "cwd": {
            "type": "string",
            "description": "工作目录，默认 process.cwd()"
          },
          "userMessages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "用户原话列表（可选）"
          },
          "cardText": {
            "type": "string",
            "description": "完整任务卡文本，含 FLOW_CARD: 前缀"
          }
        },
        "required": [
          "goal",
          "quote",
          "scope"
        ]
      }
    },
    {
      "name": "flow_claim",
      "description": "领取一次派发名额（executor 或 auditor）。返回四段合同 prompt，可直接作为子 Agent 的任务描述。",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "会话 ID，默认 unknown"
          },
          "role": {
            "type": "string",
            "enum": [
              "executor",
              "auditor"
            ],
            "description": "领取角色"
          },
          "cwd": {
            "type": "string",
            "description": "工作目录，默认 process.cwd()"
          }
        },
        "required": [
          "sessionId",
          "role"
        ]
      }
    },
    {
      "name": "flow_dispatch",
      "description": "按四段合同派发子 Agent。派发前会自动对 scope 内文件做快照。",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "会话 ID，默认 unknown"
          },
          "role": {
            "type": "string",
            "enum": [
              "executor",
              "auditor"
            ],
            "description": "派发角色"
          },
          "message": {
            "type": "string",
            "description": "附加说明，原样附在合同末尾"
          },
          "run": {
            "type": "boolean",
            "description": "true = 由本工具直接运行 opencode；false/absent = 只返回 prompt"
          },
          "cwd": {
            "type": "string",
            "description": "工作目录，默认 process.cwd()"
          }
        },
        "required": [
          "sessionId",
          "role"
        ]
      }
    },
    {
      "name": "flow_audit_axes",
      "description": "派发两个并行审计 subagent（Standards 轴 / Spec 轴），生成两段审计合同 prompt。executor 改动通过 flow_run_verify 与负对照后、落 PASS 裁定前必须先调用本工具。",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "会话 ID"
          },
          "cwd": {
            "type": "string",
            "description": "仓库工作目录，默认 process.cwd()"
          }
        }
      }
    },
    {
      "name": "flow_audit_submit",
      "description": "保存某一审计轴（standards|spec）的结论与证据到会话状态。PASS 裁定前必须两轴都提交，且各自绑定的 card_ts 与当前卡一致。同轴可重复提交（后者覆盖）。",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "会话 ID"
          },
          "axis": {
            "type": "string",
            "enum": [
              "standards",
              "spec"
            ],
            "description": "审计轴"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "WARN"
            ],
            "description": "轴判定；WARN=坏味道等 judgement call，不硬拦"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "每条含 file:line 或证据"
          },
          "evidence": {
            "type": "string",
            "description": "实跑命令输出 / diff 摘录"
          }
        }
      }
    },
    {
      "name": "flow_audit_guard",
      "description": "校验两轴是否已通过且证据齐全（与 flow_verdict 内的双轴门禁同口径）。主 Agent 落 PASS 前可主动自查；flow_verdict 不受此调用影响，仍会再拦一道。",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "会话 ID"
          }
        }
      }
    },
    {
      "name": "flow_verdict",
      "description": "记录 auditor 的裁定结果（PASS / DIRECTION / LOCAL）。只有 PASS 会把 completed_ok 置为 true。",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "会话 ID，默认 unknown"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "PASS",
              "DIRECTION",
              "LOCAL"
            ],
            "description": "裁定结果"
          },
          "notes": {
            "type": "string",
            "description": "裁定说明/证据摘要"
          },
          "role": {
            "type": "string",
            "description": "记录裁定者角色（通常 auditor）"
          },
          "cwd": {
            "type": "string",
            "description": "工作目录，默认 process.cwd()"
          }
        },
        "required": [
          "sessionId",
          "verdict"
        ]
      }
    },
    {
      "name": "flow_status",
      "description": "查询当前会话的门禁状态：是否有任务卡、风险档、已派发次数/上限、裁定结果、是否过期、是否处于免检模式。",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "会话 ID，默认 unknown"
          }
        },
        "required": [
          "sessionId"
        ]
      }
    },
    {
      "name": "flow_audit",
      "description": "读取审计流水，返回事件列表与按 type/kind 的统计。",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "会话 ID；不传则聚合全部"
          },
          "type": {
            "type": "string",
            "description": "事件类型过滤：run / finding / decision / resolution"
          },
          "limit": {
            "type": "number",
            "description": "最多返回最近 N 条"
          },
          "date": {
            "type": "string",
            "description": "YYYY-MM-DD，默认今天"
          }
        }
      }
    },
    {
      "name": "flow_diff_hunks",
      "description": "对指定文件跑 git diff -U0 并解析出每个文件的 hunk 范围。",
      "parameters": {
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "description": "仓库工作目录，默认 process.cwd()"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "要检查的文件路径列表"
          }
        },
        "required": [
          "cwd"
        ]
      }
    },
    {
      "name": "flow_bypass",
      "description": "开关免检模式。仅在用户明确授权时使用。",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "会话 ID，默认 unknown"
          },
          "on": {
            "type": "boolean",
            "description": "true 开启免检，false 关闭"
          },
          "reason": {
            "type": "string",
            "description": "开启/关闭理由（建议写用户原话）"
          }
        },
        "required": [
          "sessionId",
          "on"
        ]
      }
    },
    {
      "name": "flow_add_user_msg",
      "description": "写入一条用户原话到会话消息文件，供 quote 锚点校验使用。",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "会话 ID，默认 unknown"
          },
          "text": {
            "type": "string",
            "description": "用户原话原文"
          }
        },
        "required": [
          "sessionId",
          "text"
        ]
      }
    },
    {
      "name": "flow_save_result",
      "description": "保存子 Agent 执行结果到会话目录。",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "会话 ID，默认 unknown"
          },
          "role": {
            "type": "string",
            "enum": [
              "executor",
              "auditor"
            ],
            "description": "执行角色"
          },
          "stdout": {
            "type": "string",
            "description": "子 Agent 的 stdout"
          },
          "stderr": {
            "type": "string",
            "description": "子 Agent 的 stderr"
          },
          "code": {
            "type": "number",
            "description": "退出码"
          }
        },
        "required": [
          "sessionId",
          "role"
        ]
      }
    },
    {
      "name": "flow_revert_plan",
      "description": "根据本次会话的快照 manifest 生成还原计划。只返回计划，不自动执行。",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "会话 ID，默认 unknown"
          },
          "cwd": {
            "type": "string",
            "description": "工作目录，默认 process.cwd()"
          }
        },
        "required": [
          "sessionId"
        ]
      }
    },
    {
      "name": "flow_run_verify",
      "description": "执行卡片中指定的验证命令，返回执行结果（退出码、stdout、stderr）。用于在派发 executor 后验证其工作成果，或手动触发验证。记 PASS 裁定前必须先跑通本工具。",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "会话 ID，默认 unknown"
          },
          "cwd": {
            "type": "string",
            "description": "工作目录，默认 process.cwd()"
          }
        }
      }
    },
    {
      "name": "flow_falsify",
      "description": "负对照（negative control）：把工作区还原到派发时的「改动前」状态跑同一 verify.cmd，要求它失败；再还原「改动后」状态跑一次，要求它通过。只有「改动前失败 + 改动后通过」才证明这个测试真的在测本次改动（而不是 `|| true` / `echo ok` 这类空测试）。记 PASS 裁定前必须先做负对照。",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "会话 ID，默认 unknown"
          },
          "cwd": {
            "type": "string",
            "description": "工作目录，默认 process.cwd()"
          }
        }
      }
    },
    {
      "name": "flow_check_scope",
      "description": "检查指定文件列表是否在卡片 scope 范围内。用于在提交裁定前自查越界改动。空 scope 判定为全部越界（fail-closed）。",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "会话 ID，默认 unknown"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "要检查的文件路径列表"
          },
          "cwd": {
            "type": "string",
            "description": "仓库工作目录，默认 process.cwd()"
          }
        },
        "required": [
          "sessionId"
        ]
      }
    },
    {
      "name": "flow_trigger_check",
      "description": "智能触发检查：判断当前这条用户消息是否应该启动 Carlos 工作流，并在达标时实际完成激活（写入用户原话 + 开占位卡 → 会话进入门禁态）。宿主在收到用户消息时调用本工具，就能获得与命令行客户端完全一致的自动触发行为。未达阈值时只如实返回评分与决策，不做任何动作；被限流时也如实返回真实评分。中文流程词（工作流/门禁/派发/审计…）已内置，中文需求同样能触发。",
      "parameters": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "会话 ID，默认 unknown"
          },
          "message": {
            "type": "string",
            "description": "用户本轮消息原文（必须是真实原话，用于 quote 锚点）"
          },
          "complexity": {
            "type": "number",
            "description": "任务复杂度系数，默认 1.0"
          },
          "execute": {
            "type": "boolean",
            "description": "true = 达标时实际执行激活步骤（默认 true）；false = 只评分不动作"
          },
          "cwd": {
            "type": "string",
            "description": "工作目录，默认 process.cwd()"
          }
        },
        "required": [
          "message"
        ]
      }
    }
  ]
}
