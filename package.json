{
  "name": "carlos-flow-cindy",
  "version": "2.5.5",
  "description": "Carlos 工作流 MCP - Cindy 适配版（自动管理 Bridge，内置密钥库集成）",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "carlos-flow": "client/carlos.js"
  },
  "scripts": {
    "test": "node test/smoke.js",
    "test:e2e": "node test/e2e-carlos.mjs",
    "test:p0": "node test/p0-gates.mjs",
    "test:trigger": "node test/trigger-e2e.mjs",
    "test:concurrency": "node test/concurrency-e2e.mjs",
    "test:acceptance": "node test/e2e-acceptance.mjs",
    "test:all": "npm run test && npm run test:e2e && npm run test:p0 && npm run test:trigger && npm run test:concurrency",
    "test:mutation": "node scripts/mutation-check.mjs",
    "sync:readme": "node scripts/sync-readme.mjs",
    "check:readme": "node scripts/sync-readme.mjs --check",
    "check:parity": "node scripts/check-repo-parity.mjs",
    "clean:readme": "node scripts/clean-readme-noise.mjs README.md README.zh.md README.en.md && npm run sync:readme",
    "prepublishOnly": "npm run check:readme",
    "start:bridge": "node bridge/mcp-bridge.js",
    "lint": "echo \"no linter configured\""
  },
  "keywords": [
    "carlos",
    "workflow",
    "mcp",
    "cindy",
    "gate",
    "audit"
  ],
  "author": "Carlos Flow Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skyer-now/carlos-flow-cindy.git"
  },
  "bugs": {
    "url": "https://github.com/skyer-now/carlos-flow-cindy/issues"
  },
  "homepage": "https://github.com/skyer-now/carlos-flow-cindy#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "files": [
    "src/",
    "bridge/",
    "client/",
    "test/",
    "scripts/",
    "ghost.json",
    "settings.html",
    "settings.js",
    ".env.example",
    "README.md",
    "README.en.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "TRIGGER_GUIDE.md"
  ]
}
