{
  "name": "carlos-flow",
  "version": "2.28.1",
  "description": "Carlos 工作流 — AI 编码 Agent 的机械门禁。留痕/派发/验证/裁定/审计/还原，约束写在代码里而非提示词里。单一包支持 Cindy/OpenCode/Cursor/Cline/VS Code/Claude Desktop。",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "carlos-flow": "client/carlos.js",
    "carlos-flow-cindy": "client/carlos.js",
    "carlos-flow-opencode": "client/carlos.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./cindy": "./ghost.json",
    "./opencode": "./opencode.json",
    "./trigger-config": "./trigger-config.usable.json"
  },
  "scripts": {
    "test:handlers": "node test/handler-parity.mjs",
    "test": "node test/smoke.js",
    "test:e2e": "node test/e2e-carlos.mjs",
    "test:baseline": "node test/audit-baseline.mjs",
    "test:p0": "node test/p0-gates.mjs",
    "test:trigger": "node test/trigger-e2e.mjs",
    "test:concurrency": "node test/concurrency-e2e.mjs",
    "test:ui": "node test/verify-ui.mjs",
    "test:acceptance": "node test/e2e-acceptance.mjs",
    "test:all": "npm run test && npm run test:baseline && npm run test:e2e && npm run test:p0 && npm run test:trigger && npm run test:concurrency && npm run test:acceptance && npm run test:gate && npm run test:stale && npm run test:scope && npm run test:audit && npm run test:bridge && npm run test:clean && npm run test:ui && npm run test:sensitive && npm run test:lock && npm run test:falsify && npm run test:mcp && npm run test:dispatch && npm run test:hardening && npm run test:cas && npm run test:roll && npm run test:prune",
    "test:mutation": "node scripts/mutation-check.mjs",
    "sync:readme": "node scripts/sync-readme.mjs",
    "check:readme": "node scripts/sync-readme.mjs --check",
    "check:identity": "node scripts/check-repo-parity.mjs",
    "check:parity": "node scripts/check-repo-parity.mjs",
    "clean:readme": "node scripts/clean-readme-noise.mjs README.md README.zh.md README.en.md && npm run sync:readme",
    "prepublishOnly": "npm run check:readme",
    "start:bridge": "node bridge/mcp-bridge.js",
    "lint": "echo \"no linter configured\"",
    "check:anchors": "node scripts/check-mutant-anchors.mjs",
    "init:cindy": "node client/carlos.js init --target cindy",
    "init:opencode": "node client/carlos.js init --target opencode",
    "init:cursor": "node client/carlos.js init --target cursor",
    "init:cline": "node client/carlos.js init --target cline",
    "init:vscode": "node client/carlos.js init --target vscode",
    "init:claude": "node client/carlos.js init --target claude",
    "check:lang": "node scripts/lang-audit.mjs",
    "test:lang": "node test/lang-audit.test.mjs",
    "check:full": "node scripts/full-audit.mjs",
    "test:package": "node test/package-e2e.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:params": "node scripts/check-params.mjs",
    "check:no-dead-handler": "node scripts/check-no-dead-handler.mjs",
    "test:scope": "node test/scope-enforcement.mjs",
    "test:audit": "node test/audit-chain.mjs",
    "test:bridge": "node test/bridge-identity.mjs && node test/bridge-idle.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "check:version": "node scripts/check-repo-parity.mjs",
    "test:gate": "node test/publish-gate.test.mjs",
    "install:hooks": "node scripts/install-hooks.mjs",
    "check:hooks": "node scripts/install-hooks.mjs --check",
    "test:stale": "node test/verify-stale.test.mjs",
    "test:sensitive": "node test/sensitive-config.mjs",
    "test:lock": "node test/state-lock.mjs",
    "test:falsify": "node test/falsify-restore.mjs",
    "test:mcp": "node test/mcp-stdio.mjs",
    "test:dispatch": "node test/cindy-dispatch.mjs",
    "test:hardening": "node test/hardening.mjs",
    "test:cas": "node test/verify-cas.mjs",
    "test:roll": "node test/audit-roll.mjs",
    "test:prune": "node test/prune.mjs",
    "prune": "node scripts/prune.mjs",
    "check:portability": "node scripts/check-portability.mjs",
    "bench:latency": "node scripts/bench-latency.mjs",
    "check:templates": "node scripts/check-templates.mjs",
    "test:clean": "node test/clean-command.mjs"
  },
  "keywords": [
    "carlos",
    "workflow",
    "mcp",
    "cindy",
    "opencode",
    "gate",
    "audit",
    "trigger"
  ],
  "author": "Carlos Flow Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skyer-now/carlos-flow.git"
  },
  "bugs": {
    "url": "https://github.com/skyer-now/carlos-flow/issues"
  },
  "homepage": "https://github.com/skyer-now/carlos-flow#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {},
  "files": [
    "ui/narrator.js",
    "settings.html",
    "settings.js",
    "main.js",
    "client/",
    "src/",
    "bridge/",
    "plugins/",
    "scripts/",
    "templates/",
    "ghost.json",
    "opencode.json",
    "opencode.json.template",
    ".mcprc.template",
    "trigger-config.usable.json",
    "trigger-config.example.json",
    "README.md",
    "README.zh.md",
    "README.en.md",
    "TRIGGER_GUIDE.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "LICENSE",
    "AGENTS.md",
    "INSTALL.md",
    "RELEASE_NOTES.md",
    "check-all.sh",
    "smoke-test.js"
  ]
}
