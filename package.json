{
  "name": "carlos-flow",
  "version": "2.6.1",
  "description": "Carlos 工作流 — AI 编码 Agent 的机械门禁。留痕/派发/验证/裁定/审计/还原，约束写在代码里而非提示词里。单一包支持 Cindy/OpenCode/Cursor/Cline/VS Code/Claude Desktop。",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "carlos-flow": "client/carlos.js",
    "carlos-flow-cindy": "client/carlos.js",
    "carlos-flow-opencode": "client/carlos.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./cindy": "./ghost.json",
    "./opencode": "./opencode.json",
    "./trigger-config": "./trigger-config.usable.json"
  },
  "scripts": {
    "test": "node test/smoke.js",
    "test:e2e": "node test/e2e-carlos.mjs",
    "test:p0": "node test/p0-gates.mjs",
    "test:trigger": "node test/trigger-e2e.mjs",
    "test:concurrency": "node test/concurrency-e2e.mjs",
    "test:acceptance": "node test/e2e-acceptance.mjs",
    "test:all": "npm run test && npm run test:e2e && npm run test:p0 && npm run test:trigger && npm run test:concurrency && npm run test:acceptance",
    "test:mutation": "node scripts/mutation-check.mjs",
    "sync:readme": "node scripts/sync-readme.mjs",
    "check:readme": "node scripts/sync-readme.mjs --check",
    "check:identity": "node scripts/check-repo-parity.mjs",
    "check:parity": "node scripts/check-repo-parity.mjs",
    "clean:readme": "node scripts/clean-readme-noise.mjs README.md README.zh.md README.en.md && npm run sync:readme",
    "prepublishOnly": "npm run check:readme",
    "start:bridge": "node bridge/mcp-bridge.js",
    "lint": "echo \"no linter configured\"",
    "check:anchors": "node scripts/check-mutant-anchors.mjs",
    "init:cindy": "node client/carlos.js init --target cindy",
    "init:opencode": "node client/carlos.js init --target opencode",
    "init:cursor": "node client/carlos.js init --target cursor",
    "init:cline": "node client/carlos.js init --target cline",
    "init:vscode": "node client/carlos.js init --target vscode",
    "init:claude": "node client/carlos.js init --target claude",
    "check:lang": "node scripts/lang-audit.mjs"
  },
  "keywords": [
    "carlos",
    "workflow",
    "mcp",
    "cindy",
    "opencode",
    "gate",
    "audit",
    "trigger"
  ],
  "author": "Carlos Flow Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skyer-now/carlos-flow.git"
  },
  "bugs": {
    "url": "https://github.com/skyer-now/carlos-flow/issues"
  },
  "homepage": "https://github.com/skyer-now/carlos-flow#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "files": [
    "client/",
    "src/",
    "bridge/",
    "plugins/",
    "scripts/",
    "templates/",
    "ghost.json",
    "opencode.json",
    "opencode.json.template",
    ".mcprc.template",
    "trigger-config.usable.json",
    "trigger-config.example.json",
    "README.md",
    "README.zh.md",
    "README.en.md",
    "TRIGGER_GUIDE.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
