# 依赖
node_modules/

# 环境配置（含敏感信息）
.env
.env.local
.env.*.local

# 运行时产物
*.log
*.pid
bridge.pid
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 测试临时目录
carlos-flow-smoke-*
carlos-flow-smoke-proj-*

# IDE/编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db

# Cindy 专用（运行时生成）
.carlos-flow/
gate-state/
gate-audit/

# 覆盖率报告
coverage/

# 打包产物
*.tgz
*.tar.gz
# npm 本地凭据（绝不入库）
.npmrc.local
.npmrc.*.local
# .npmrc 本身是入库的模板文件（含注释），但真实凭据必须放在 .npmrc.local
!.npmrc

# 一次性调试/修复脚本与临时产物
fix_*.mjs
fix*.mjs
debug_*.mjs
do_patch.*
patch_phase1.py
apply_*.mjs
add_tools*.mjs
add_new_tools.mjs
